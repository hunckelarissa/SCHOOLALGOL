   <!-- Window → Perspective → Open Perspective → ALG -->
   <extension point="org.eclipse.ui.perspectives">
      <perspective
            id="org.myau.shaya.ide.perspective"
            name="ALG"
            class="org.myau.shaya.ide.ui.ShayaPerspectiveFactory"
            icon="icons/alg.png"/>
   </extension>

   <!-- Project nature + incremental check builder -->
   <extension
         id="shayaNature"
         name="ALG Project Nature"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run class="org.myau.shaya.ide.nature.ShayaNature"/>
      </runtime>
      <builder id="org.myau.shaya.ide.shayaBuilder"/>
   </extension>

   <extension point="org.eclipse.ui.ide.projectNatureImages">
      <image
            id="org.myau.shaya.ide.natureImage"
            natureId="org.myau.shaya.ide.shayaNature"
            icon="icons/alg.png"/>
   </extension>

   <extension
         id="shayaBuilder"
         name="ALG Check Builder"
         point="org.eclipse.core.resources.builders">
      <builder hasNature="true">
         <run class="org.myau.shaya.ide.builder.ShayaBuilder"/>
      </builder>
   </extension>

   <!-- New wizards -->
   <extension point="org.eclipse.ui.newWizards">
      <category id="org.myau.shaya.ide.wizards" name="ALG"/>
      <wizard
            id="org.myau.shaya.ide.wizards.newProject"
            name="ALG Project"
            category="org.myau.shaya.ide.wizards"
            icon="icons/alg.png"
            project="true"
            class="org.myau.shaya.ide.wizards.ShayaNewProjectWizard">
         <description>Create an ALG project with Hello.alg (RU) and Hello_en.alg (EN)</description>
      </wizard>
      <wizard
            id="org.myau.shaya.ide.wizards.newHello"
            name="ALG Hello"
            category="org.myau.shaya.ide.wizards"
            icon="icons/alg.png"
            class="org.myau.shaya.ide.wizards.ShayaNewHelloWizard">
         <description>Create a Hello.alg sample (RU or EN keywords)</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <!-- Step-debug markers / breakpoints (SHAYDBG) -->
   <extension
         id="lineBreakpointMarker"
         name="ALG Line Breakpoint"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.debug.core.lineBreakpointMarker"/>
      <persistent value="true"/>
   </extension>
   <extension
         id="currentlinemarker"
         name="ALG Current Debug Line"
         point="org.eclipse.core.resources.markers">
      <super type="org.eclipse.core.resources.textmarker"/>
      <persistent value="false"/>
   </extension>
   <extension point="org.eclipse.debug.core.breakpoints">
      <breakpoint
            id="org.myau.shaya.ide.lineBreakpoint"
            class="org.myau.shaya.ide.debug.ShayaLineBreakpoint"
            markerType="org.myau.shaya.ide.lineBreakpointMarker"
            name="ALG Line Breakpoint"/>
   </extension>
   <extension point="org.eclipse.core.runtime.adapters">
      <factory
            adaptableType="org.myau.shaya.ide.editor.ShayaEditor"
            class="org.myau.shaya.ide.debug.ShayaBreakpointAdapterFactory">
         <adapter type="org.eclipse.debug.ui.actions.IToggleBreakpointsTarget"/>
      </factory>
   </extension>
   <extension point="org.eclipse.debug.core.sourceLocators">
      <sourceLocator
            id="org.myau.shaya.ide.sourceLocator"
            class="org.myau.shaya.ide.debug.model.ShayaSourceLocator"
            name="ALG Source Locator"/>
   </extension>
   <extension point="org.eclipse.debug.core.debugModelPresentations">
      <debugModelPresentation
            class="org.myau.shaya.ide.debug.ui.ShayaDebugModelPresentation"
            id="org.myau.shaya.ide.debugModel"/>
   </extension>
   <extension point="org.eclipse.debug.core.watchExpressionDelegates">
      <watchExpressionDelegate
            debugModel="org.myau.shaya.ide.debugModel"
            delegateClass="org.myau.shaya.ide.debug.ShayaWatchExpressionDelegate"/>
   </extension>
   <extension point="org.eclipse.ui.propertyPages">
      <page
            id="org.myau.shaya.ide.breakpointPropertyPage"
            name="ALG Breakpoint"
            class="org.myau.shaya.ide.debug.ShayaBreakpointPropertyPage">
         <enabledWhen>
            <or>
               <instanceof value="org.myau.shaya.ide.debug.ShayaLineBreakpoint"/>
               <adapt type="org.myau.shaya.ide.debug.ShayaLineBreakpoint"/>
            </or>
         </enabledWhen>
      </page>
   </extension>

   <!-- Run As / Debug As → ALG Application -->
   <extension point="org.eclipse.debug.core.launchConfigurationTypes">
      <launchConfigurationType
            id="org.myau.shaya.ide.launchConfigurationType"
            name="ALG Application"
            delegate="org.myau.shaya.ide.launch.ShayaLaunchDelegate"
            modes="run,debug"
            public="true"
            sourceLocatorId="org.myau.shaya.ide.sourceLocator"/>
   </extension>
   <extension point="org.eclipse.debug.ui.launchConfigurationTabGroups">
      <launchConfigurationTabGroup
            id="org.myau.shaya.ide.launchTabGroup"
            type="org.myau.shaya.ide.launchConfigurationType"
            class="org.myau.shaya.ide.launch.ShayaLaunchTabGroup"/>
   </extension>
   <extension point="org.eclipse.debug.ui.launchShortcuts">
      <shortcut
            id="org.myau.shaya.ide.launchShortcut"
            name="ALG Application"
            class="org.myau.shaya.ide.launch.ShayaLaunchShortcut"
            modes="run,debug"
            icon="icons/run.png"
            description="Run .alg with SCHOOLALGOL">
         <contextualLaunch>
            <enablement>
               <with variable="selection">
                  <count value="1"/>
                  <iterate>
                     <adapt type="org.eclipse.core.resources.IResource">
                        <test property="org.eclipse.core.resources.name" value="*.alg"/>
                     </adapt>
                  </iterate>
               </with>
            </enablement>
         </contextualLaunch>
         <configurationType id="org.myau.shaya.ide.launchConfigurationType"/>
      </shortcut>
   </extension>

</plugin>
