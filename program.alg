использовать "utils.alg"

алг ОсновнаяПрограмма
  | Главная программа, демонстрирующая все возможности
нач
  конст ВЕРСИЯ = 2.0
  цел число
  лит приветствие
  таб вещ данные[1:3]
  файл f

  вывод "Язык v", ВЕРСИЯ, ", автор модуля: ", АВТОР

  число := 6
  приветствие := "Факториал числа "
  вывод приветствие:20, число, " = ", Факториал(число)

  данные[1] := корень(144)
  данные[2] := случ() * 100
  данные[3] := данные[1] + данные[2]

  открыть(f, "report.txt", "запись")
  вывод f, "Отчет о выполнении:"
  вывод f, " - ", приветствие, число, " = ", Факториал(число):10:2
  вывод f, " - Случайное число: ", данные[2]:10:4
  закрыть(f)

  вывод "Отчет был успешно записан в файл report.txt"
кон